<div class="container">
  <h1>Add a new review to <%= @restaurant.name %></h1>
  <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.label :rating, class: "mb-3" %>
    <%= f.select :rating, options_for_select(Review::RATINGS) %>
    <%= f.input :content %>
    <%= f.submit "Submit review", class: "btn btn-primary" %>
  <% end %>
</div>
