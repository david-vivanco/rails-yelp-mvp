# new.html.erb
<div class="container m=3">
  <h1>Add a new restaurant</h1>
  <%= simple_form_for [@restaurant] do |f| %>
   <%= f.input :name %>
   <%= f.label :category, class: "mb-3" %>
   <%= f.select :category, options_for_select(Restaurant::CATEGORIES) %>
   <%= f.input :address %>
   <%= f.input :phone_number %>
   <%= f.submit "Submit" %>
  <% end %>
</div>
